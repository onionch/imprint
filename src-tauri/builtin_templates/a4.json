{
  "version": 1,
  "canvas": {
    "width_mm": 210,
    "height_mm": 297,
    "background_color": "#FFFFFF",
    "border_radius_mm": 0
  },
  "elements": [
    {
      "id": "el_name",
      "type": "text",
      "x_mm": 0,
      "y_mm": 0,
      "width_mm": 90,
      "height_mm": 20,
      "content": "{{attendee_name}}",
      "style": { "font_family": "Microsoft YaHei", "font_size_pt": 16, "font_weight": "bold", "color": "#1F2329", "text_align": "center", "vertical_align": "middle" },
      "z_index": 1
    },
    {
      "id": "el_dept",
      "type": "text",
      "x_mm": 0,
      "y_mm": 20,
      "width_mm": 90,
      "height_mm": 10,
      "content": "{{attendee_department}}",
      "style": { "font_family": "Microsoft YaHei", "font_size_pt": 8, "font_weight": "normal", "color": "#646A73", "text_align": "center", "vertical_align": "middle" },
      "z_index": 2
    },
    {
      "id": "el_qr",
      "type": "qrcode",
      "x_mm": 33,
      "y_mm": 32,
      "width_mm": 18,
      "height_mm": 18,
      "content": "{{qr_data}}",
      "style": { "foreground_color": "#1F2329", "background_color": "#FFFFFF" },
      "z_index": 3
    }
  ]
}