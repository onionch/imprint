{
  "version": 1,
  "canvas": {
    "width_mm": 54,
    "height_mm": 86,
    "background_color": "#FFFFFF",
    "border_radius_mm": 3
  },
  "elements": [
    {
      "id": "el_header",
      "type": "rectangle",
      "x_mm": 0,
      "y_mm": 0,
      "width_mm": 54,
      "height_mm": 14,
      "style": { "fill_color": "#0C1D36", "border_radius_mm": 0 },
      "z_index": 0
    },
    {
      "id": "el_speaker",
      "type": "text",
      "x_mm": 2,
      "y_mm": 1,
      "width_mm": 50,
      "height_mm": 12,
      "content": "SPEAKER",
      "style": { "font_family": "Microsoft YaHei", "font_size_pt": 11, "font_weight": "bold", "color": "#FFFFFF", "text_align": "center", "vertical_align": "middle" },
      "z_index": 1
    },
    {
      "id": "el_name",
      "type": "text",
      "x_mm": 4,
      "y_mm": 24,
      "width_mm": 46,
      "height_mm": 20,
      "content": "{{attendee_name}}",
      "style": { "font_family": "Microsoft YaHei", "font_size_pt": 24, "font_weight": "bold", "color": "#1F2329", "text_align": "center", "vertical_align": "middle" },
      "z_index": 2
    },
    {
      "id": "el_position",
      "type": "text",
      "x_mm": 4,
      "y_mm": 46,
      "width_mm": 46,
      "height_mm": 8,
      "content": "{{attendee_position}}",
      "style": { "font_family": "Microsoft YaHei", "font_size_pt": 9, "font_weight": "normal", "color": "#646A73", "text_align": "center", "vertical_align": "middle" },
      "z_index": 3
    },
    {
      "id": "el_qr",
      "type": "qrcode",
      "x_mm": 17,
      "y_mm": 57,
      "width_mm": 20,
      "height_mm": 20,
      "content": "{{qr_data}}",
      "style": { "foreground_color": "#1F2329", "background_color": "#FFFFFF" },
      "z_index": 4
    }
  ]
}